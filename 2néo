from pathlib import Path

html = r'''<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Pixel Pals — Cute Platformer</title>
<style>
:root{--ink:#493b5a;--pink:#ff9fc8;--cream:#fff8e9;--mint:#a9e8ce;--lav:#c8b9ff}
*{box-sizing:border-box}
